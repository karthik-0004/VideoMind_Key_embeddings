    "segs": [ {
      "utf8": "this is actually fairly useful\nand allows you to avoid trying"
    } ]
  }, {
    "tStartMs": 1065300,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "to do like a try accept block\nto see if something exists or not."
    } ]
  }, {
    "tStartMs": 1069100,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "So you can see that I can check\nif X exists on C or y exists on C."
    } ]
  }, {
    "tStartMs": 1072966,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "As always, we're using a string here\nrather than typing out what the actual"
    } ]
  }, {
    "tStartMs": 1076733,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "I guess character would be."
    } ]
  }, {
    "tStartMs": 1078166,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "So if I run this here, notice that C\ndoes have x, but it does not have y."
    } ]
  }, {
    "tStartMs": 1081733,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "The next function that I have here\nis known as help."
