  }, {
    "tStartMs": 1145066,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "Now this creates an alias, meaning"
    } ]
  }, {
    "tStartMs": 1146600,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "that it's just going to be a reference\nto the exact same object."
    } ]
  }, {
    "tStartMs": 1149600,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "So the idea of x and y should be the same\nmeaning anything I change on"
    } ]
  }, {
    "tStartMs": 1153433,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "x will change on y."
    } ]
  }, {
    "tStartMs": 1155433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "So let's have a look at this."
